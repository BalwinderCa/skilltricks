# Copy to .env.dusk.local, then run:  php artisan key:generate --env=dusk.local
#
# Dusk drives a real HTTP server in its own process, so it cannot use the
# container mocks the PHPUnit suite relies on. AI_PROVIDER=fake selects the
# deterministic provider in AiProviderService, which is guarded to non-production
# environments.
#
# .env.dusk.local is gitignored because it is usually derived from .env and
# carries real credentials. Only the keys below are actually needed.

APP_NAME=SkillTricks
APP_ENV=dusk
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# A file, not :memory: — the test process and the served app are different
# processes and must see the same database.
DB_CONNECTION=sqlite
DB_DATABASE=/absolute/path/to/database/dusk.sqlite

AI_PROVIDER=fake

SESSION_DRIVER=file
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
